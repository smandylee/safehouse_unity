<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:sh="Safehouse.UI.Chrome">
    <ui:Style src="Theme.uss" />

    <!--
      The SETTINGS screen: game options and data-folder management.
      Laid out in exact pixels against the same 1440x900 artboard as the other screens.
    -->
    <ui:VisualElement name="settings-root" class="gear-root" style="flex-direction: column;">

        <!-- TOP BAR -->
        <ui:VisualElement class="bar bar-top">
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-right: 22px;">
                <ui:Label text="SAFEHOUSE" class="text-heading" />
            </ui:VisualElement>
            <ui:Button text="CHARACTER" name="navtab-character" class="navtab" />
            <ui:Button text="GEAR" name="navtab-gear" class="navtab" />
            <ui:Button text="HIDEOUT" name="navtab-hideout" class="navtab" />
            <ui:Button text="TRADERS" name="navtab-traders" class="navtab" />
            <ui:Button text="SCAVENGE" name="navtab-scavenge" class="navtab" />
            <ui:Button text="QUESTS" class="navtab navtab-disabled" focusable="false" />
            <ui:VisualElement style="flex-grow: 1;" />
            <ui:Button text="SETTINGS" name="navtab-settings" class="navtab navtab-active" />
        </ui:VisualElement>

        <!-- MAIN -->
        <ui:VisualElement style="flex-grow: 1; flex-direction: row; padding: 14px 24px; min-height: 0;">
            <sh:FacetedPanel style="width: 420px; flex-shrink: 0; flex-direction: column; padding: 14px; margin-right: 16px;">
                <ui:Label text="SETTINGS" class="text-section" style="margin-bottom: 10px;" />
                <ui:Label text="Game data and options. Most settings require a restart to take effect." class="text-muted" style="font-size: 11px; white-space: normal; margin-bottom: 14px;" />

                <ui:VisualElement class="card" style="padding: 10px 12px; margin-bottom: 10px;">
                    <ui:Label text="DATA FOLDER" class="text-label" />
                    <ui:Label name="label-data-folder" text="—" class="text-mono" style="font-size: 11px; white-space: normal; margin-top: 4px;" />
                    <ui:Button name="button-open-folder" text="OPEN FOLDER" class="btn btn-outline" style="margin-top: 8px; font-size: 11px; height: 26px;" />
                </ui:VisualElement>

                <ui:VisualElement style="flex-grow: 1;" />
                <ui:Label name="label-status" text="" class="text-muted" style="font-size: 11px; white-space: normal;" />
            </sh:FacetedPanel>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

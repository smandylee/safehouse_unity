# Unity generated folders. All of these are rebuilt from Assets/ + Packages/ +
# ProjectSettings/, so committing them only creates merge conflicts.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store downloads (re-downloadable, and often not redistributable).
/[Aa]ssets/AssetStoreTools*

# Auto-saved scene recovery from an unclean Editor exit (a force-quit, a crash). Not real content -
# Unity regenerates this on the next launch after one, from whatever scene was open.
/[Aa]ssets/_Recovery*

# Visual Studio / Rider / VS Code project files - regenerated by Unity.
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports and build byproducts.
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Same rules as the Python project: saves and game art never get committed.
# Escape from Tarkov icons/images/descriptions are private use only.
/local_data/
/icon_cache/
/[Aa]ssets/StreamingAssets/icons/
